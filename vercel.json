{
  "version": 2,
  "builds": [
    {
      "src": "examples/try-online/vite.config.ts",
      "use": "@vercel/vite"
    }
  ],
  "outputs": {
    "examples/try-online/dist/**/*": {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/examples/try-online/index.html"
    }
  ]
}
